# ---------------------------------------------------------------------------
# IncidentIQ configuration
#
# Copy this file to ".env" and fill in AI_API_KEY.
# The ".env" file is git-ignored and must NEVER be committed.
#
# IncidentIQ talks to any OpenAI-compatible chat endpoint. To switch provider,
# change these three values only - never the code.
# ---------------------------------------------------------------------------

# The endpoint, key and model. Defaults below use Google Gemini, which has a
# free tier. Get a free key at https://aistudio.google.com/apikey and paste it
# after AI_API_KEY= .
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_API_KEY=
AI_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------------------
# Other providers - to switch, comment out the two Gemini lines above and
# uncomment one block below (AI_BASE_URL is already set above; override it too).
# ---------------------------------------------------------------------------

# --- Groq (free tier, very fast) -------------------------------------------
# Key: https://console.groq.com/keys
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=llama-3.3-70b-versatile

# --- OpenRouter (many models, some free) -----------------------------------
# Key: https://openrouter.ai/keys
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=google/gemini-2.0-flash-exp:free

# --- Ollama (local, no key, fully offline) ---------------------------------
# Install from https://ollama.com then run:  ollama pull llama3.1
# AI_API_KEY can be any non-empty placeholder - Ollama ignores it.
# AI_BASE_URL=http://localhost:11434/v1
# AI_API_KEY=ollama
# AI_MODEL=llama3.1

# --- OpenAI ----------------------------------------------------------------
# Key: https://platform.openai.com/api-keys
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# --- Anthropic (OpenAI-compatibility endpoint) -----------------------------
# Key: https://console.anthropic.com/settings/keys
# AI_BASE_URL=https://api.anthropic.com/v1/
# AI_MODEL=claude-opus-4-8

# ---------------------------------------------------------------------------
# Shared options (rarely need changing)
# ---------------------------------------------------------------------------

# Maximum tokens the model may produce per analysis stage.
MAX_OUTPUT_TOKENS=16000

# Web server host and port.
HOST=127.0.0.1
PORT=8000

# Set to "true" to print each prompt to the console before it is sent. Useful
# while writing about the prompts, because it shows the exact text that was used.
LOG_PROMPTS=false
