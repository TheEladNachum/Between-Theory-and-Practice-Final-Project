# ---------------------------------------------------------------------------
# IncidentIQ configuration
#
# Copy this file to ".env" and fill in the blanks.
# The ".env" file is git-ignored and must NEVER be committed.
# ---------------------------------------------------------------------------

# REQUIRED. Your Anthropic API key.
# Get one at https://console.anthropic.com/settings/keys
# Leave everything after the "=" and paste your key there.
ANTHROPIC_API_KEY=

# OPTIONAL. The Claude model used for every analysis stage.
ANTHROPIC_MODEL=claude-opus-4-8

# OPTIONAL. Reasoning depth / cost trade-off for the model.
# One of: low | medium | high | xhigh | max
# "high" is a good balance for this project. Use "low" to save tokens while
# developing, "xhigh" when you want the most careful reasoning.
ANTHROPIC_EFFORT=high

# OPTIONAL. Maximum tokens the model may produce per analysis stage.
MAX_OUTPUT_TOKENS=16000

# OPTIONAL. Web server host and port.
HOST=127.0.0.1
PORT=8000

# OPTIONAL. Set to "true" to print each prompt to the console before it is
# sent to the model. Very useful while writing the reflective report, because
# it lets you copy the exact prompts that were used.
LOG_PROMPTS=false
